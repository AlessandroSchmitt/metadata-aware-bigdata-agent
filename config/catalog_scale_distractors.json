{
  "description": "Metadata-only hard-negative sources for the frozen catalog-scale experiment. They are not Spark execution datasets.",
  "scales": {
    "4": 0,
    "8": 4,
    "16": 12
  },
  "datasets": [
    {
      "name": "for_hire_vehicle_trips",
      "display_name": "NYC For-Hire Vehicle Trips",
      "description": "For-hire vehicle trip records with pickup and dropoff times, zone identifiers, and travelled distance.",
      "granularity": "one row per for-hire vehicle trip",
      "primary_time_column": "pickup_time",
      "aliases": [
        "for hire vehicle trips",
        "fhv trips",
        "rideshare trips"
      ],
      "columns": [
        {"name": "pickup_time", "type": "timestamp_ntz", "semantic_concept": "pickup_datetime"},
        {"name": "dropoff_time", "type": "timestamp_ntz", "semantic_concept": "dropoff_datetime"},
        {"name": "pickup_zone_id", "type": "bigint"},
        {"name": "dropoff_zone_id", "type": "bigint"},
        {"name": "trip_miles", "type": "double", "semantic_concept": "trip_distance"},
        {"name": "base_number", "type": "string"}
      ]
    },
    {
      "name": "bike_share_trips",
      "display_name": "NYC Bike Share Trips",
      "description": "Bike-share ride records with trip start and end times, stations, travelled distance, and rider type.",
      "granularity": "one row per bike-share ride",
      "primary_time_column": "started_at",
      "aliases": [
        "bike share trips",
        "bicycle trips",
        "citibike trips"
      ],
      "columns": [
        {"name": "started_at", "type": "timestamp_ntz", "semantic_concept": "pickup_datetime"},
        {"name": "ended_at", "type": "timestamp_ntz", "semantic_concept": "dropoff_datetime"},
        {"name": "start_station_name", "type": "string"},
        {"name": "end_station_name", "type": "string"},
        {"name": "ride_distance_miles", "type": "double", "semantic_concept": "trip_distance"},
        {"name": "member_type", "type": "string"}
      ]
    },
    {
      "name": "weather_daily",
      "display_name": "NYC Daily Weather Summary",
      "description": "Daily weather observations containing temperature summaries and precipitation status for New York City.",
      "granularity": "one row per calendar day",
      "primary_time_column": "weather_date",
      "aliases": [
        "daily weather",
        "daily climate observations",
        "weather summaries"
      ],
      "columns": [
        {"name": "weather_date", "type": "date"},
        {"name": "mean_temperature_f", "type": "double", "semantic_concept": "temperature"},
        {"name": "max_temperature_f", "type": "double", "semantic_concept": "temperature"},
        {"name": "min_temperature_f", "type": "double", "semantic_concept": "temperature"},
        {"name": "had_precipitation", "type": "boolean", "semantic_concept": "precipitation_status"},
        {"name": "precipitation_total_in", "type": "double"}
